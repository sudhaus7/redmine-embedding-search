{
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
	"license": "MIT",
	"authors": [
		{
			"name": "Frank Berger",
			"email": "fberger@sudhaus7.de",
			"homepage": "https://sudhaus7.de",
			"role": "Developer"
		}
	],
    "require": {
        "php": "8.3.* || 8.2.*",
        "bluestone/redmine-api": "^1.2",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "openai-php/client": "^v0.10",
        "predis/predis": "^2.3",
        "symfony/cache": "^7.1",
        "symfony/console": "^7.0",
        "symfony/http-client": "^6.4",
        "symfony/polyfill-uuid": "^1.30",
        "symfony/yaml": "^7.1"
    },

    "autoload": {
        "psr-4": {
            "Redminesearch\\": "src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.60",
        "typo3/coding-standards": "^0.8.0"
    },
    "scripts":{
        "csfixer": "@php vendor/bin/php-cs-fixer fix"
    }
}
